# Copy to .env (local) or set as GitHub Actions repository variables
# (Settings -> Secrets and variables -> Actions -> Variables).
# Everything prefixed VITE_ ends up in the public JavaScript bundle. Never put secrets here.

# Google Apps Script web app URL that records form submissions in Google Sheets (see apps-script/README.md).
# Leave empty to run the forms in a clearly labelled demo mode: nothing is sent or stored.
VITE_LEADS_ENDPOINT=

# Store listings. Leave empty while the apps are unpublished: the store cards then show "Coming soon".
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=

# Optional public contact email shown on the Contact page.
VITE_CONTACT_EMAIL=

# Base path. GitHub Actions sets /green-plug-ev-website/ automatically for the project site.
BASE_PATH=/
