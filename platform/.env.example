# GREEN PLUG EV platform — environment variables.
# Copy to .env (never commit it) and fill in real values only on the server. No variable here is required
# for local demo mode; the defaults run everything against a local PostgreSQL with clearly labelled demo adapters.

# ---- server
# production enables startup safety checks (see README "Production")
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# public origin in production, e.g. https://app.example.com
APP_ORIGIN=http://localhost:8080
# true in production (HTTPS)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# how often expired payment holds are released
HOLD_SWEEP_SECONDS=30
# multiplies per-IP rate limits (tests only)
RATE_LIMIT_FACTOR=1
# station photos; default platform/storage (use object storage in production)
STORAGE_DIR=
LOG_REQUESTS=1

# ---- database (PostgreSQL 14+ with the btree_gist and citext extensions)
DATABASE_URL=postgres://postgres:devpassword@127.0.0.1:5433/gpev_dev
TEST_DATABASE_URL=postgres://postgres:devpassword@127.0.0.1:5433/gpev_test
E2E_DATABASE_URL=postgres://postgres:devpassword@127.0.0.1:5433/gpev_e2e

# ---- demo mode: demo inbox, TEST checkout, seeded demo accounts. Must be false in production.
DEMO_MODE=true
# overrides the seeded admin password
SEED_ADMIN_PASSWORD=
# overrides the seeded demo-user passwords
SEED_DEMO_PASSWORD=

# ---- payments (real collection stays disabled until all four are configured and verified)
# test | razorpay
PAYMENT_PROVIDER=test
PAYMENTS_LIVE_ENABLED=false
# HMAC secret for webhook signatures (provider dashboard); 24+ chars
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- maps, geocoding, routing
# demo | google
MAPS_PROVIDER=demo
# server-side key: Geocoding/Places/Routes (never sent to the browser)
MAPS_SERVER_API_KEY=
# browser key: Maps JavaScript API, HTTP-referrer restricted
MAPS_BROWSER_API_KEY=

# ---- messaging (verification codes, booking updates)
# demo writes to the in-app demo inbox
EMAIL_PROVIDER=demo
SMS_PROVIDER=demo
PUSH_PROVIDER=demo
